{
  "openapi": "3.1.0",
  "info": {
    "title": "Intercom selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.intercom.io"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "operationId": "intercom_list_contacts",
        "summary": "intercom list contacts",
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 150
            }
          },
          {
            "name": "Intercom-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2.15",
              "default": "2.15"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "intercom_create_contact",
        "summary": "intercom create contact",
        "parameters": [
          {
            "name": "Intercom-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2.15",
              "default": "2.15"
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "const": "lead",
                    "default": "lead"
                  }
                },
                "required": [
                  "email",
                  "role"
                ]
              }
            }
          }
        }
      }
    },
    "/contacts/{contact_id}": {
      "get": {
        "operationId": "intercom_get_contact",
        "summary": "intercom get contact",
        "parameters": [
          {
            "name": "contact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Intercom-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2.15",
              "default": "2.15"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
